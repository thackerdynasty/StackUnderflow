@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="card-header">
            <h1 class="auth-title text-danger">@ViewData["Title"]</h1>
        </div>
        <div class="card-body">
            <p class="auth-note text-danger">This account has been locked out, please try again later.</p>
        </div>
    </div>
</div>
