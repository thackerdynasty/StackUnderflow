@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="card-header">
            <h1 class="auth-title">@ViewData["Title"]</h1>
        </div>
        <div class="card-body">
            <partial name="_StatusMessage" model="Model.StatusMessage" />
        </div>
    </div>
</div>
