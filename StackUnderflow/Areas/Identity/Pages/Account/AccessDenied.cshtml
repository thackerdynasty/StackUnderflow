@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="card-header">
            <h1 class="auth-title text-danger">@ViewData["Title"]</h1>
        </div>
        <div class="card-body">
            <p class="auth-note text-danger">You do not have access to this resource.</p>
        </div>
    </div>
</div>
