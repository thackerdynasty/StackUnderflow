@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="card-header">
            <h1 class="auth-title">@ViewData["Title"]</h1>
        </div>
        <div class="card-body">
            @{
                if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" class="auth-form">
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Click here to Logout</button>
                    </form>
                }
                else
                {
                    <p class="auth-note">You have successfully logged out of the application.</p>
                }
            }
        </div>
    </div>
</div>
