@using StackUnderflow.Utilities
@model AnswerViewModel

@{
    var post = Model.Post;
    var threadId = Model.ThreadId;
    var isThreadOwner = Model.IsThreadOwner;
    var currentUserId = Model.CurrentUserId;
    var editPostId = Model.EditPostId;
    var editCommentId = Model.EditCommentId;

    var answerScore = post.Upvotes - post.Downvotes;
    var postAuthorName = post.User?.UserName ?? "unknown user";
    var isAnswerOwner = currentUserId != null && post.UserId == currentUserId;
    var answerVote = Model.AnswerVote;
    var comments = (post.Comments ?? Array.Empty<Comment>())
        .OrderBy(comment => comment.CreatedAt)
        .ToList();
}

<article id="answer-@post.Id"
         class="thread-post answer-post @(post.IsAcceptedAnswer ? "accepted-answer" : "")"
         data-answer-score="@answerScore"
         data-answer-created-at="@post.CreatedAt.ToUniversalTime().ToString("O")"
         data-answer-accepted="@post.IsAcceptedAnswer.ToString().ToLowerInvariant()"
         style="scroll-margin-top: 1rem;">
    <aside class="vote-column" aria-label="Answer score">
        <form asp-controller="Thread" asp-action="VoteAnswer" asp-route-threadId="@threadId" asp-route-postId="@post.Id" method="post" class="vote-form">
            @if (isAnswerOwner)
            {
                <button type="submit" name="vote" value="up" class="vote-control @(answerVote == 1 ? "is-selected" : "")" aria-label="Upvote answer" disabled>▲</button>
            }
            else
            {
                <button type="submit" name="vote" value="up" class="vote-control @(answerVote == 1 ? "is-selected" : "")" aria-label="Upvote answer">▲</button>
            }
        </form>
        <strong>@answerScore</strong>
        <form asp-controller="Thread" asp-action="VoteAnswer" asp-route-threadId="@threadId" asp-route-postId="@post.Id" method="post" class="vote-form">
            @if (isAnswerOwner)
            {
                <button type="submit" name="vote" value="down" class="vote-control @(answerVote == -1 ? "is-selected" : "")" aria-label="Downvote answer" disabled>▼</button>
            }
            else
            {
                <button type="submit" name="vote" value="down" class="vote-control @(answerVote == -1 ? "is-selected" : "")" aria-label="Downvote answer">▼</button>
            }
        </form>
        @if (post.IsAcceptedAnswer)
        {
            <div class="accepted-mark" title="Accepted answer" aria-label="Accepted answer">✓</div>
        }
    </aside>

    <div class="post-body">
        @if (editPostId == post.Id && isAnswerOwner)
        {
            <form asp-controller="Thread" asp-action="EditAnswer" asp-route-threadId="@threadId" asp-route-postId="@post.Id" method="post" class="inline-edit-form">
                @Html.AntiForgeryToken()
                @if (TempData["PostEditError"] is string postEditError)
                {
                    <div class="text-danger answer-error">@postEditError</div>
                }
                <label for="post-edit-@post.Id" class="form-label">Edit your answer</label>
                <textarea id="post-edit-@post.Id" name="content" class="form-control" rows="8">@post.Content</textarea>

                <!-- Live preview for the post edit content -->
                <div class="mt-3">
                    <h4 class="h6">Preview</h4>
                    <div id="post-edit-preview-@post.Id" class="card card-body" style="min-height: 6rem; white-space: pre-wrap;"></div>
                </div>

                <div class="inline-edit-actions">
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                    <a asp-controller="Thread" asp-action="Detail" asp-route-id="@threadId" asp-fragment="answer-@post.Id" class="btn btn-secondary btn-sm">Cancel</a>
                </div>
            </form>

            <script>
                (function() {
                    if (typeof attachLivePreview === 'function') {
                        attachLivePreview('#post-edit-@post.Id', '#post-edit-preview-@post.Id');
                    } else {
                        document.addEventListener('DOMContentLoaded', function() {
                            attachLivePreview('#post-edit-@post.Id', '#post-edit-preview-@post.Id');
                        });
                    }
                })();
            </script>
        }
        else
        {
            <div class="post-content">@Html.Raw(ContentParser.RenderCodeBlocks(post.Content))</div>
        }

        <footer class="post-footer">
            <div class="post-actions">
                @if (isAnswerOwner)
                {
                    <a asp-controller="Thread" asp-action="Detail" asp-route-id="@threadId" asp-route-editPostId="@post.Id" asp-fragment="answer-@post.Id">Edit</a>
                    <form asp-controller="Thread" asp-action="DeleteAnswer" asp-route-threadId="@threadId" asp-route-postId="@post.Id" method="post" class="link-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" onclick="return confirm('Delete this answer?');">Delete</button>
                    </form>
                }
            </div>

            <div class="user-card">
                <span>answered @post.CreatedAt.ToString("MMM d, yyyy")</span>
                <a asp-controller="Profile" asp-action="Details" asp-route-id="@post.UserId"><strong>@postAuthorName</strong></a>
                <span>@(post.User?.Reputation ?? 0) reputation</span>
            </div>
        </footer>

        @if (isThreadOwner && !post.IsAcceptedAnswer && !Model.ThreadIsSolved)
        {
            <form asp-controller="Thread" asp-action="AcceptAnswer" asp-route-id="@threadId" asp-route-postId="@post.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-primary"
                        style="background-color: green; outline-color: green; border-color: green;"
                        title="Mark as accepted answer"
                        aria-label="Mark as accepted answer">Accept Answer</button>
            </form>
        }

        <div class="comment-list">
            @foreach (var comment in comments)
            {
                var isCommentOwner = currentUserId != null && comment.UserId == currentUserId;
                <div id="comment-@comment.Id" class="comment" style="scroll-margin-top: 1rem;">
                    @if (editCommentId == comment.Id && isCommentOwner)
                    {
                        <form asp-controller="Thread" asp-action="EditComment" asp-route-threadId="@threadId" asp-route-commentId="@comment.Id" method="post" class="inline-comment-edit-form">
                            @Html.AntiForgeryToken()
                            @if (TempData["CommentEditError"] is string commentEditError)
                            {
                                <div class="text-danger answer-error">@commentEditError</div>
                            }
                            <label for="comment-edit-@comment.Id" class="visually-hidden">Edit comment</label>
                            <textarea id="comment-edit-@comment.Id" name="content" class="form-control form-control-sm" rows="3">@comment.Content</textarea>
                            <div class="inline-edit-actions">
                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                <a asp-controller="Thread" asp-action="Detail" asp-route-id="@threadId" asp-fragment="comment-@comment.Id" class="btn btn-secondary btn-sm">Cancel</a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <span>@comment.Content</span>
                        <span class="comment-meta">- <a asp-controller="Profile" asp-action="Details" asp-route-id="@comment.UserId">@(comment.User?.UserName ?? "unknown user")</a> @comment.CreatedAt.ToString("MMM d, yyyy")</span>
                        @if (isCommentOwner)
                        {
                            <span class="comment-actions">
                                <a asp-controller="Thread" asp-action="Detail" asp-route-id="@threadId" asp-route-editCommentId="@comment.Id" asp-fragment="comment-@comment.Id">Edit</a>
                                <form asp-controller="Thread" asp-action="DeleteComment" asp-route-threadId="@threadId" asp-route-commentId="@comment.Id" method="post" class="link-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" onclick="return confirm('Delete this comment?');">Delete</button>
                                </form>
                            </span>
                        }
                    }
                </div>
            }
            <form asp-action="PostComment" asp-route-id="@threadId" asp-route-postId="@post.Id" method="post">
                @Html.AntiForgeryToken()
                @if (TempData["CommentError"] is string commentError)
                {
                    <div class="text-danger answer-error">@commentError</div>
                }
                <textarea id="comment-content-@post.Id" name="content" class="form-control-sm" placeholder="Your comment..." style="margin-top: 8px;"></textarea>
                <br/>
                <button type="submit" class="btn btn-secondary btn-sm">Add comment</button>
            </form>
        </div>
    </div>
</article>
